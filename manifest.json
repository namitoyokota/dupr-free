{
  "manifest_version": 3,
  "name": "DUPR Free",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "View a DUPR player's profile, ratings, and match history from their DUPR dashboard page.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "DUPR Free",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://dashboard.dupr.com/*"],
      "js": ["search-navigation.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
